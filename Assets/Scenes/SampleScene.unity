  chapterDescriptionText: {fileID: 1298715629}
  textChapter0: "\u0424\u043E\u043A\u0443\u0441 \u043D\u0430 \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u0445.
    \u0428\u0443\u043A\u0430\u0442\u0438\u043C\u0443 \u0442\u0435, \u0449\u043E \u043F\u0456\u0434\u0431\u0430\u0434\u044C\u043E\u0440\u044E\u0454
    \u043C\u0435\u043D\u0435 \u0437\u0430\u0440\u0430\u0437."
  textChapter1: "\u0412\u0456\u0434\u043D\u0430\u0439\u0442\u0438 \u0434\u0456\u044E.
    \u0417\u043D\u0430\u0439\u0442\u0438 \u0440\u0443\u0442\u0438\u043D\u0438 \u0442\u0430
    \u0434\u0456\u0457, \u0449\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0443\u0442\u044C
    \u043F\u043E\u043A\u0440\u0430\u0449\u0438\u0442\u0438 \u043C\u0456\u0439 \u0444\u0456\u0437\u0438\u0447\u043D\u0438\u0439
    \u0441\u0442\u0430\u043D."
  textChapter2: "\u0410\u043D\u0430\u043B\u0456\u0437 \u043C\u0438\u043D\u0443\u043B\u043E\u0433\u043E.
    \u0417\u043E\u0441\u0435\u0440\u0435\u0434\u0436\u0443\u0441\u044F \u043D\u0430
    \u0432\u0430\u0436\u043B\u0438\u0432\u0438\u0445 \u043F\u043E\u0434\u0456\u044F\u0445
    \u0436\u0438\u0442\u0442\u044F"
  textChapter3: "\u0417\u043D\u0435\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u043D\u044F
    \u0441\u0430\u043C\u043E\u043A\u0440\u0438\u0442\u0438\u043A\u0438. \u0417\u043D\u0430\u0439\u0442\u0438
    \u043F\u0440\u0438\u043A\u043C\u0435\u0442\u043D\u0438\u043A\u0438, \u044F\u043A\u0438\u043C\u0438
    \u044F \u043E\u0431\u0440\u0430\u0436\u0430\u044E \u0441\u0435\u0431\u0435, \u0449\u043E\u0431
    \u0457\u0445 \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u0430\u0442\u0438."
  textChapter4: "\u042F\u0434\u0440\u043E \u043A\u043E\u043D\u0444\u043B\u0456\u043A\u0442\u0443.
    \u0412\u0438\u0437\u043D\u0430\u0447\u0443 \u043A\u043B\u044E\u0447\u043E\u0432\u0456
    \u0442\u0435\u043C\u0438, \u044F\u043A\u0456 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0435
    \u0442\u0443\u0440\u0431\u0443\u044E\u0442\u044C \u0442\u0430 \u0441\u0442\u043E\u044F\u0442\u044C
    \u043D\u0430 \u0448\u043B\u044F\u0445\u0443."
  animateText: 0
  typewriterSpeed: 0.05
  gridSpawner: {fileID: 2118655122}
  autoUpdateChapter: 1
  updateInterval: 0.5
