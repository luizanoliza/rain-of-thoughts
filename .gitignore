# This .gitignore file is configured for Unity projects
# Excludes temporary directories, build outputs, and editor user preferences

# Builds
/[Bb]uild/
/[Bb]uilds/
*.apk
*.aab
*.unitypackage
*.app

# Unity temporary directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Aa]ssets/AssetStoreTools*

# Autogenerated Visual Studio / IDE project files
.vs/
.vscode/
.idea/
.gradle/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity autogenerated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash reports
sysinfo.txt
crashlytics-build.properties

# OS files
.DS_Store
Thumbs.db
Desktop.ini
